DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Multi-tenant conversion (Phase B) ---
# Used to extract a tenant's subdomain from the request's Host header
# (e.g. acme.tracker.vistoriasystems.com -> "acme"). Only matters once
# Phase D's wildcard DNS/nginx are live - until then every request hits
# the bare domain and falls back to the first tenant created.
BASE_DOMAIN=tracker.vistoriasystems.com

# --- Microsoft Teams integration (optional) ---
# Get these from your organization's Azure AD app registration.
# See TEAMS_INTEGRATION.md for exactly what to request from your IT/DevOps team.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Must be your backend's public HTTPS URL + /integrations/teams/webhook
# (e.g. https://api.yourcompany.com/integrations/teams/webhook).
# Microsoft Graph cannot reach localhost, so this only works once the
# backend is deployed somewhere with a real public address.
MS_TEAMS_WEBHOOK_URL=
